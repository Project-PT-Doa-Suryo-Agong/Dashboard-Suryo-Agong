# ---- Printer Agent config ----
# Port lokal tempat agent mendengarkan request dari aplikasi web.
PRINT_AGENT_PORT=9100

# Tipe printer thermal. Default "epson" (command set paling umum, kompatibel
# dengan kebanyakan printer thermal generik). Opsi: epson | star | brother | generic
PRINTER_TYPE=epson

# ---- WAJIB diisi SETELAH printer tersedia (lihat README.md) ----
# Pilih SALAH SATU interface sesuai cara printer terhubung:
#   1) USB serial (Device Manager > Ports COM & LPT):
#        PRINTER_INTERFACE=\\.\COM3
#   2) Printer sistem Windows (Devices and Printers) — butuh npm i printer:
#        PRINTER_INTERFACE=printer:POS-58
#   3) Printer jaringan (TCP/IP):
#        PRINTER_INTERFACE=tcp://192.168.1.50:9100
# Biarkan kosong dulu kalau printer fisik belum tersedia.
PRINTER_INTERFACE=

# Lebar kertas thermal dalam mm — sumber utama lebar struk (charactersPerLine).
# Default 80. Mendukung minimal 58 dan 80 (bisa nilai lain; 100, 110 untuk
# lebar ekstra). Tidak terhubung dengan fitur "pilih ukuran kertas" di aplikasi.
PRINTER_WIDTH_MM=80

# Timeout komunikasi printer dalam milidetik.
PRINTER_TIMEOUT_MS=5000

# (Opsional) Override manual jumlah karakter per baris. Kalau > 0, nilai ini
# menang atas PRINTER_WIDTH_MM. Biarkan 0 untuk menghitung otomatis.
PRINTER_WIDTH_CHARS=0

# Origin/domain yang boleh memanggil agent ini (CORS). Comma-separated.
# Tambahkan domain production pada baris yang sama.
PRINT_AGENT_CORS_ORIGINS=http://localhost:3000