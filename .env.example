NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_COOKIE_DOMAIN=localhost

CHAT_LOGS_API_URL=https://your-chat-logs-project-id.supabase.co/functions/v1/chat_logs
CHAT_LOGS_GROUP_IDS=groupid1@g.us,groupid2@g.us
CHAT_LOGS_SUPABASE_KEY=your_chat_logs_supabase_anon_key

# URL printer-agent lokal (lihat printer-agent/README.md). Default http://localhost:9100
NEXT_PUBLIC_PRINT_AGENT_URL=http://localhost:9100

# Mode print struk: "thermal" (default — via printer-agent) | "legacy" (print browser/PDF).
NEXT_PUBLIC_PRINT_MODE=thermal
